# =========================================================================
# 🚨 iReport - Cybercrime Assistant Environment Configuration
# Copy this file to .env for local development.
# For Vercel: Set these variables in Vercel Project Settings -> Environment Variables.
# =========================================================================

# Flask Application Settings
SECRET_KEY=ireport-super-secret-key-change-in-production
JWT_SECRET_KEY=ireport-jwt-secret-key-change-in-production

# Database Configuration
# Local SQLite fallback: sqlite:///ireport.db
# Production (Vercel / Neon / Supabase): postgresql://user:password@ep-xyz.postgres.database.azure.com/ireport
DATABASE_URL=sqlite:///ireport.db

# Email / Mail Server Settings (Optional - for OTP & Alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Indian SMS & Twilio Service Settings (Optional)
FAST2SMS_API_KEY=your-fast2sms-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-number

# Server & CORS Ports
PORT=5000
FRONTEND_PORT=3000
