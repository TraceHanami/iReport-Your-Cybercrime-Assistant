# =========================================================================
# 🚨 iReport - Cybercrime Assistant Environment Configuration Example
# Copy this file to .env before starting the server.
# =========================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ireport-super-secret-key-change-in-production

# JWT Authentication
JWT_SECRET_KEY=ireport-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration
DATABASE_URL=sqlite:///database/ireport.db

# Server Ports
PORT=5000
FRONTEND_PORT=3000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
